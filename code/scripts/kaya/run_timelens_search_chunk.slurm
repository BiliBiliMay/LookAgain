#!/bin/bash
#SBATCH -J timelens_search_chunk
#SBATCH -p gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:v100:2
#SBATCH --cpus-per-task=16
#SBATCH --mem=160G
#SBATCH --time=12:00:00
#SBATCH -o /scratch/pmc073/huwang/timelens/logs/timelens_search_chunk_%j.out
#SBATCH -e /scratch/pmc073/huwang/timelens/logs/timelens_search_chunk_%j.err

set -euo pipefail

REPO_ROOT=${REPO_ROOT:-/group/pmc073/huwang/worktrees/TimeLens/timelens-search-wrapper}
SCRATCH_ROOT=${SCRATCH_ROOT:-/scratch/pmc073/huwang/timelens}
DATA_ROOT=${DATA_ROOT:-$SCRATCH_ROOT/data/TimeLens-Bench}
BASELINE_RUN_DIR=${BASELINE_RUN_DIR:-/scratch/pmc073/huwang/timelens/outputs/timelens8b_dm_repro_20260424_223712}
RUN_DIR=${RUN_DIR:?RUN_DIR is required}
DATASET=${DATASET:?DATASET is required}
CHUNK=${CHUNK:?CHUNK is required}
INDEX=${INDEX:-${SLURM_ARRAY_TASK_ID:-}}
INDEX=${INDEX:?INDEX is required}
MIN_TOKENS=${MIN_TOKENS:-64}
TOTAL_TOKENS=${TOTAL_TOKENS:-14336}
MAX_NEW_TOKENS=${MAX_NEW_TOKENS:-512}
FPS=${FPS:-2}
ZOOM_FPS=${ZOOM_FPS:-4}
DENSE_ZOOM_FPS=${DENSE_ZOOM_FPS:-8}
SEARCH_MODE=${SEARCH_MODE:-budgeted_graph}
COARSE_GRID_SIZE=${COARSE_GRID_SIZE:-9}
COARSE_WINDOW_FRACTION=${COARSE_WINDOW_FRACTION:-0.25}
REFINE_ROUNDS=${REFINE_ROUNDS:-2}
TOP_K_STAGE1=${TOP_K_STAGE1:-5}
TOP_K_REFINE=${TOP_K_REFINE:-5}
MIN_WINDOW_SECONDS=${MIN_WINDOW_SECONDS:-4.0}
TINY_EVENT_WINDOW_SECONDS=${TINY_EVENT_WINDOW_SECONDS:-8.0}
DIFFUSE_CONFIDENCE_THRESHOLD=${DIFFUSE_CONFIDENCE_THRESHOLD:-0.30}
BROAD_BASELINE_FRACTION=${BROAD_BASELINE_FRACTION:-0.60}
BROAD_REPLACE_THRESHOLD=${BROAD_REPLACE_THRESHOLD:-0.55}
MAX_TOTAL_CALLS=${MAX_TOTAL_CALLS:-15}
GRAPH_SEED_COUNT=${GRAPH_SEED_COUNT:-5}
GRAPH_BEAM_WIDTH=${GRAPH_BEAM_WIDTH:-3}
GRAPH_MERGE_IOU=${GRAPH_MERGE_IOU:-0.92}
GRAPH_SUPPORT_IOU=${GRAPH_SUPPORT_IOU:-0.55}
LOOKAGAIN_CONTROLLER=${LOOKAGAIN_CONTROLLER:-guided}
LOOKAGAIN_ANCHOR_PERIOD=${LOOKAGAIN_ANCHOR_PERIOD:-3}
CERTIFICATE_BOUNDARY_IOU=${CERTIFICATE_BOUNDARY_IOU:-0.55}
CERTIFICATE_SUPPORT_IOU=${CERTIFICATE_SUPPORT_IOU:-0.55}
CERTIFICATE_CONTRADICTION_WEIGHT=${CERTIFICATE_CONTRADICTION_WEIGHT:-0.45}
MAX_CONTROLLER_TRACE_STEPS=${MAX_CONTROLLER_TRACE_STEPS:-256}
CRITIC_MODE=${CRITIC_MODE:-self}
CRITIC_CALLS=${CRITIC_CALLS:-2}
CRITIC_FPS=${CRITIC_FPS:-4}
CRITIC_MIN_CONFIDENCE=${CRITIC_MIN_CONFIDENCE:-0.55}
DTYPE=${DTYPE:-auto}
ATTN_IMPLEMENTATION=${ATTN_IMPLEMENTATION:-sdpa}
USE_CACHE=${USE_CACHE:-auto}
SDPA_BACKEND=${SDPA_BACKEND:-efficient}
FORCE_REPEAT_KV_FOR_SDPA=${FORCE_REPEAT_KV_FOR_SDPA:-1}
MAX_EXAMPLES=${MAX_EXAMPLES:-}
NUM_WORKERS=${NUM_WORKERS:-0}
PREFETCH_FACTOR=${PREFETCH_FACTOR:-2}
PIN_MEMORY=${PIN_MEMORY:-false}
SKIP_VIDEO_ERRORS=${SKIP_VIDEO_ERRORS:-false}
COMPUTE_METRICS=${COMPUTE_METRICS:-0}
MODEL_PATH_FILE=${MODEL_PATH_FILE:-$SCRATCH_ROOT/models/timelens8b_snapshot_path.txt}
DEVICE=${DEVICE:-balanced}
MAX_GPU_MEMORY_GIB=${MAX_GPU_MEMORY_GIB:-14}
CPU_OFFLOAD_GIB=${CPU_OFFLOAD_GIB:-120}
OFFLOAD_STATE_DICT=${OFFLOAD_STATE_DICT:-true}
OFFLOAD_FOLDER=${OFFLOAD_FOLDER:-$SCRATCH_ROOT/offload/${SLURM_JOB_ID}}

export HF_HOME=${HF_HOME:-$SCRATCH_ROOT/hf_home}
export HF_HUB_CACHE=${HF_HUB_CACHE:-$SCRATCH_ROOT/hf_cache}
export PIP_CACHE_DIR=${PIP_CACHE_DIR:-$SCRATCH_ROOT/pip_cache}
export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}
export PYTHONUNBUFFERED=${PYTHONUNBUFFERED:-1}

mkdir -p "$SCRATCH_ROOT/logs" "$RUN_DIR" "$OFFLOAD_FOLDER"

cd "$REPO_ROOT"
export HF_HOME
export HF_HUB_CACHE
export PIP_CACHE_DIR
export PYTORCH_CUDA_ALLOC_CONF
export PYTHONUNBUFFERED
export SCRATCH_ROOT
export DATA_ROOT
export BASELINE_RUN_DIR
export RUN_DIR
export DATASETS="$DATASET"
export MIN_TOKENS
export TOTAL_TOKENS
export MAX_NEW_TOKENS
export FPS
export ZOOM_FPS
export DENSE_ZOOM_FPS
export SEARCH_MODE
export COARSE_GRID_SIZE
export COARSE_WINDOW_FRACTION
export REFINE_ROUNDS
export TOP_K_STAGE1
export TOP_K_REFINE
export MIN_WINDOW_SECONDS
export TINY_EVENT_WINDOW_SECONDS
export DIFFUSE_CONFIDENCE_THRESHOLD
export BROAD_BASELINE_FRACTION
export BROAD_REPLACE_THRESHOLD
export MAX_TOTAL_CALLS
export GRAPH_SEED_COUNT
export GRAPH_BEAM_WIDTH
export GRAPH_MERGE_IOU
export GRAPH_SUPPORT_IOU
export LOOKAGAIN_CONTROLLER
export LOOKAGAIN_ANCHOR_PERIOD
export CERTIFICATE_BOUNDARY_IOU
export CERTIFICATE_SUPPORT_IOU
export CERTIFICATE_CONTRADICTION_WEIGHT
export MAX_CONTROLLER_TRACE_STEPS
export CRITIC_MODE
export CRITIC_CALLS
export CRITIC_FPS
export CRITIC_MIN_CONFIDENCE
export DTYPE
export ATTN_IMPLEMENTATION
export USE_CACHE
export SDPA_BACKEND
export FORCE_REPEAT_KV_FOR_SDPA
export MAX_EXAMPLES
export NUM_WORKERS
export PREFETCH_FACTOR
export PIN_MEMORY
export SKIP_VIDEO_ERRORS
export COMPUTE_METRICS
export MODEL_PATH_FILE
export DEVICE
export MAX_GPU_MEMORY_GIB
export CPU_OFFLOAD_GIB
export OFFLOAD_STATE_DICT
export OFFLOAD_FOLDER
export TP_PLAN=none
export CHUNK
export INDEX

bash "$REPO_ROOT/scripts/kaya/run_timelens_search_eval.sh"
